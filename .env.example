# =============================================================================
# HERAI Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust variables as needed for your local environment.
# Never commit real secret keys, production credentials, or private databases to git.

# SQLite Database Location Override (Optional)
# Defaults to data/herai.db in the project root if unset.
HERAI_DB_PATH=data/herai.db

# Optional Streamlit Server Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_THEME_BASE=light

